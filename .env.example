# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/atlas_business?schema=public"

# Session secret for client portal / admin auth (jose JWT). Use a long random string in production.
SESSION_SECRET=""

# Secret that guards the Vercel Cron endpoint (/api/cron/ein-reminders).
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""

# Admin bootstrap credentials (created by seed)
ADMIN_EMAIL="admin@atlasbusiness.co"
ADMIN_PASSWORD=""

# Stripe — leave blank to run in demo mode (simulated checkout, no real charges)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public base URL used to build redirect links (Stripe, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend) — https://resend.com
# Leave blank to log emails to the console + the admin Email log instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Atlas Business System <no-reply@atlasbusiness.co>"
